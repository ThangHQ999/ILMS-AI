# Copy selected values to your own environment; no credentials are included here.
# Existing final tables need no repeated migration. Python >=3.11 (TaskGroup/timeout).
OPENAI_SEND_TEMPERATURE=false
# Use a new collection. Backfill explicitly before sending chat requests.
CHROMA_COLLECTION_NAME=socratic_chunks
CHROMA_DISTANCE_METRIC=cosine
SOCRATIC_ENTITY_COLLECTION=socratic_knowledge_entities
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
SOCRATIC_CACHE_SECONDS=120
SOCRATIC_CACHE_SIZE=128
SOCRATIC_LEASE_SECONDS=120
SOCRATIC_REQUEST_TIMEOUT=180
SOCRATIC_MIN_SIMILARITY=0.5
SOCRATIC_RETRIEVAL_K=12
SOCRATIC_CONTEXT_CHARS=18000
SOCRATIC_INDEPENDENT_SUCCESSES=3
# Optional per-task overrides; unset values use each provider's CHAT_MODEL.
# OPENAI_INTENT_MODEL=...
# OPENAI_EVALUATION_MODEL=...
# OPENAI_QUESTION_MODEL=...
# OPENAI_ARTIFACT_MODEL=...
# GEMINI_INTENT_MODEL=...
# GEMINI_EVALUATION_MODEL=...
# Relation names can be overridden as JSON lists/strings through settings.
# SOCRATIC_SATELLITE_EDGES=["HAS_DEFINITION","HAS_EXAMPLE","HAS_ARGUMENT"]
