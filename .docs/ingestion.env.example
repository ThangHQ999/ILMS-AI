# IMPLEMENTED SUBSET + PROPOSED FUTURE SETTINGS, 2026-11-02.
# Local runner reads preprocessing settings only; see ingestion-local-guide.md.
# Worker/agents/publication settings below remain proposals, not active features.
# No secrets. Deploy shared limits to Spring Boot and Python separately.
# Numeric defaults below are starting proposals, not measured capacity.

# Admission / parsing. Format acceptance still requires a working parser adapter.
INGESTION_ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,md,py,js,ts,java,go,sql
INGESTION_MAX_FILE_MB=30
INGESTION_MAX_PAGES=300
INGESTION_MAX_SLIDES=300
INGESTION_MAX_PARSED_CHARACTERS=2000000
INGESTION_MAX_ARCHIVE_UNCOMPRESSED_MB=200
INGESTION_TEXT_ENCODING=utf-8-sig
INGESTION_MAX_CHUNKS=1500
INGESTION_PARSE_TIMEOUT_SECONDS=180
INGESTION_OCR_ENABLED=false
# OCR is deferred. Keep false for text-only ingestion.

# Worker / leases. Heartbeat < lease, provider timeout need not block heartbeat.
INGESTION_WORKER_ENABLED=false
INGESTION_WORKER_CONCURRENCY=2
INGESTION_LLM_CONCURRENCY=4
INGESTION_EMBEDDING_CONCURRENCY=2
INGESTION_JOB_POLL_SECONDS=3
INGESTION_LEASE_SECONDS=120
INGESTION_HEARTBEAT_SECONDS=20
INGESTION_MAX_JOB_ATTEMPTS=3

# Chunking. Enforce overlap < target <= maximum; use the configured tokenizer.
INGESTION_CHUNK_TARGET_TOKENS=800
INGESTION_CHUNK_MAX_TOKENS=1200
INGESTION_CHUNK_OVERLAP_TOKENS=100
INGESTION_TOKENIZER_ENCODING=cl100k_base
INGESTION_CHUNK_COMMIT_BATCH_SIZE=50
INGESTION_EXPERT_BATCH_INPUT_TOKENS=10000
INGESTION_VALIDATOR_BATCH_INPUT_TOKENS=10000
INGESTION_MAX_OUTPUT_TOKENS_PER_CALL=6000
INGESTION_CANONICAL_CANDIDATE_TOP_K=8
INGESTION_RESOLUTION_BATCH_SIZE=20

# Version identifiers must change when effective behavior changes.
INGESTION_PIPELINE_VERSION=ingestion-1
INGESTION_PARSER_VERSION=parser-1
INGESTION_CHUNKER_VERSION=chunker-1
INGESTION_PAYLOAD_SCHEMA_VERSION=knowledge-graph-1

# Empty provider/model values explicitly inherit existing shared LLM settings.
# They must resolve to supported structured-output models before worker starts.
INGESTION_LLM_PROVIDER=
INGESTION_EXTRACTOR_MODEL=
INGESTION_EXPERT_MODEL=
INGESTION_VALIDATOR_MODEL=
INGESTION_REVIEWER_MODEL=
INGESTION_LLM_TIMEOUT_SECONDS=90
INGESTION_LLM_MAX_RETRIES=2
INGESTION_LLM_RETRY_BASE_SECONDS=2
INGESTION_MAX_REPAIR_ROUNDS=1
# No universal temperature: the shared provider adapter checks model capability.
# Reuse chat embedding provider/model/dimension/collection identity settings.

# Source policy defaults. Permission to opt in belongs to the teacher/admin.
INGESTION_DEFAULT_SOURCE_POLICY=DOCUMENT_ONLY
INGESTION_EXTERNAL_FEATURE_ENABLED=false
INGESTION_AI_GENERATED_FEATURE_ENABLED=false
INGESTION_SEARCH_PROVIDER=
INGESTION_EXTERNAL_MAX_QUERIES=5
INGESTION_EXTERNAL_MAX_SOURCES=5
INGESTION_EXTERNAL_FETCH_TIMEOUT_SECONDS=20
INGESTION_EXTERNAL_MAX_SOURCE_MB=5
# Empty domains means any valid public URL, subject to network validation.
INGESTION_EXTERNAL_ALLOWED_DOMAINS=
# Credentials, if required, use the chosen provider's secret settings separately.

# Budget. 0 means disabled, explicitly; token cap is an admission/stop-call guard.
INGESTION_MAX_JOB_LLM_TOKENS=1000000
INGESTION_MAX_JOB_COST_USD=0
# Cost budget requires a configured model-price registry, otherwise startup fails
# when a positive cost cap is set. Record actual vs estimated usage distinctly.

# Publication gate: keep disabled until publisher AND chat readers are migrated.
INGESTION_PUBLISH_ENABLED=false
INGESTION_REQUIRE_ALL_CHUNKS=true
INGESTION_REQUIRE_CHROMA_FOR_PUBLISH=true
INGESTION_REQUIRE_NEO4J_FOR_PUBLISH=true
INGESTION_PROJECTION_BATCH_SIZE=100
INGESTION_PUBLICATION_TIMEOUT_SECONDS=900
# Timeout marks/reconciles work; it is not permission to activate partial data.

INGESTION_ARTIFACT_STORAGE=local
INGESTION_DEBUG_ARTIFACTS_ENABLED=false
INGESTION_STAGING_RETENTION_DAYS=14
# Retention is eligibility for reviewed cleanup, not blind recursive deletion.

# Internal BE connection. Auth is a separate secret, deliberately not shown here.
INGESTION_BE_BASE_URL=http://127.0.0.1:8080
INGESTION_BE_REQUEST_TIMEOUT_SECONDS=30
# Configure service identity/mTLS/token via deployment secret management.

# OpenAI ingestion stage models. Temperature 1 uses the provider default.
INGESTION_DEFAULT_TEMPERATURE_MODEL=gpt-6-luna
INGESTION_CUSTOM_TEMPERATURE_MODEL=gpt-4o-mini
INGESTION_EXTRACTOR_TEMPERATURE=1
INGESTION_EXPERT_TEMPERATURE=1
INGESTION_VALIDATOR_TEMPERATURE=0
INGESTION_REVIEWER_TEMPERATURE=1
INGESTION_LUNA_REASONING_EFFORT=low
INGESTION_EXTRACTION_WINDOW_TOKENS=32000
INGESTION_EXTRACTION_MAX_OUTPUT_TOKENS=8000

# Reviewable publishing and batching
INGESTION_EXPERT_BATCH_CLAIMS=32
INGESTION_PUBLICATION_COLLECTION=ilms-publications-1
INGESTION_PUBLICATION_EMBEDDING_BATCH=32
